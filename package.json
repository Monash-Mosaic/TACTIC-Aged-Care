{
  "name": "tactic-aged-care",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "ci:build": "next build",
    "start": "next start",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "jest",
    "test:coverage": "jest --coverage --ci",
    "inject-env": "node scripts/inject-public-env.mjs",
    "upload": "node scripts/inject-public-env.mjs && opennextjs-cloudflare build && wrangler versions upload"
  },
  "dependencies": {
    "next": "16.4.2",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.0",
    "@opennextjs/cloudflare": "^1.3.0",
    "@tailwindcss/turbopack": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript/native": "npm:typescript@^7.0.2",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "tailwindcss": "^4",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "wrangler": "^4.151.3"
  },
  "overrides": {
    "@node-minify/core": {
      "glob": "^10.5.0"
    },
    "nanoid": "^3.3.18",
    "postcss": "^8.5.26",
    "sharp": "^0.35.5",
    "uuid": "^11.1.1",
    "vite": "^7.3.7"
  }
}
